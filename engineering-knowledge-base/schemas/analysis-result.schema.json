{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-result.schema.json",
  "title": "Engineering Brain Analysis Result",
  "type": "object",
  "required": ["schema_version", "source_id", "title", "ten_minute_digest", "concepts", "patterns", "relationships", "evidence_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 8},
    "title": {"type": "string", "minLength": 1},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced", "research"]},
    "ten_minute_digest": {
      "type": "object",
      "required": ["why_it_matters", "core_idea", "architecture", "key_takeaways", "tradeoffs", "production_concerns", "final_takeaway"],
      "properties": {
        "why_it_matters": {"type": "string"},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "core_idea": {"type": "string"},
        "architecture": {"type": "string"},
        "key_takeaways": {"type": "array", "items": {"type": "string"}},
        "tradeoffs": {"type": "array", "items": {"type": "string"}},
        "production_concerns": {"type": "array", "items": {"type": "string"}},
        "anti_patterns": {"type": "array", "items": {"type": "string"}},
        "implementation_ideas": {"type": "array", "items": {"type": "string"}},
        "final_takeaway": {"type": "string"}
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "definition"],
        "properties": {
          "name": {"type": "string"},
          "definition": {"type": "string"},
          "importance": {"enum": ["supporting", "important", "core"]}
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "problem", "guidance"],
        "properties": {
          "name": {"type": "string"},
          "problem": {"type": "string"},
          "guidance": {"type": "string"},
          "when_to_use": {"type": "array", "items": {"type": "string"}},
          "when_not_to_use": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "to"],
        "properties": {
          "from": {"type": "string"},
          "type": {"type": "string"},
          "to": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "evidence_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "location": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "project_relevance": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
